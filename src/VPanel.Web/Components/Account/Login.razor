@page "/login"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject UserService Users
@inject AuditService Audit
@inject NavigationManager Nav

<PageTitle>Sign in · v-panel</PageTitle>

<h1 class="auth-title">Sign in</h1>

@if (_error is not null)
{
    <div class="auth-error" role="alert">@_error</div>
}

<EditForm Model="Input" FormName="login" method="post" OnValidSubmit="SignInAsync" Enhance="false">
    <DataAnnotationsValidator />
    <label class="auth-label" for="username">Username</label>
    <InputText id="username" class="auth-input" @bind-Value="Input.Username" autocomplete="username" autofocus />
    <ValidationMessage For="() => Input.Username" class="auth-validation" />

    <label class="auth-label" for="password">Password</label>
    <InputText id="password" type="password" class="auth-input" @bind-Value="Input.Password" autocomplete="current-password" />
    <ValidationMessage For="() => Input.Password" class="auth-validation" />

    <button type="submit" class="auth-button">Sign in</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = default!;

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await Users.AnyUsersAsync())
            Nav.NavigateTo("setup");
    }

    private async Task SignInAsync()
    {
        var client = HttpContext.Connection.RemoteIpAddress?.ToString();
        var (outcome, user) = await Users.VerifyAsync(Input.Username, Input.Password, client);
        if (outcome == LoginOutcome.LockedOut)
        {
            _error = "Too many failed attempts. Try again in a few minutes.";
            return;
        }
        if (outcome != LoginOutcome.Success || user is null)
        {
            _error = "Invalid username or password.";
            await Audit.LogAsync(Input.Username, "auth.login_failed", detail: client);
            return;
        }
        await SignInUserAsync(HttpContext, user);
        await Audit.LogAsync(user.Username, "auth.login", detail: client);
        Nav.NavigateTo(SafeReturnUrl(ReturnUrl), forceLoad: true);
    }

    internal static async Task SignInUserAsync(HttpContext ctx, User user)
    {
        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, user.Id.ToString()),
            new(ClaimTypes.Name, user.Username),
            new(ClaimTypes.Role, user.Role.ToString()),
        };
        var principal = new ClaimsPrincipal(new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme));
        await ctx.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal, new AuthenticationProperties { IsPersistent = true });
    }

    internal static string SafeReturnUrl(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\") ? url : "/";

    public sealed class LoginInput
    {
        [System.ComponentModel.DataAnnotations.Required] public string Username { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Password { get; set; } = "";
    }
}
