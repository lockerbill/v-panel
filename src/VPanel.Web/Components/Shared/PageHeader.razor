<div class="vp-page-header">
    <div class="vp-page-header-text">
        @if (Breadcrumbs is not null)
        {
            <div class="vp-breadcrumbs">@Breadcrumbs</div>
        }
        <MudText Typo="Typo.h4" Class="vp-title">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Subtitle</MudText>
        }
        @Meta
    </div>
    <div class="vp-page-header-actions">@Actions</div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Breadcrumbs { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Meta { get; set; }
}
