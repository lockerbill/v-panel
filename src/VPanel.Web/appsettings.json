{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "VPanel": {
    "DataDir": "/var/lib/vpanel",
    "DockerBinary": "docker",
    "SeedInfrastructure": true,
    "SeedExamples": true,
    "MaxConcurrentDeployments": 2,
    "StatusSyncInterval": "00:00:30",
    "Defaults": {
      "AppsRoot": "/opt/vpanel/apps",
      "SharedNetwork": "vpanel-shared",
      "CaddyEnabled": true,
      "CaddyContainer": "caddy",
      "CaddyDir": "/opt/vpanel/caddy",
      "CaddyConfigDirInContainer": "/etc/caddy",
      "PanelUpstream": "host.docker.internal:5080"
    }
  }
}
