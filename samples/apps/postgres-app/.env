# Admin credentials of the shared Postgres (copy from the shared-infra .env)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# Per-instance database: VPANEL_INSTANCE is injected by v-panel (e.g. pgapp-01)
DB_NAME=app_${VPANEL_INSTANCE}
DB_USER=app_${VPANEL_INSTANCE}
DB_PASSWORD=change-me-too
